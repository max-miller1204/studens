{
  "name": "studens",
  "version": "0.11.9",
  "private": true,
  "description": "Interactive HTML lessons for Pi, Claude Code, and Codex, with passage questions and graded quizzes.",
  "type": "module",
  "license": "MIT",
  "author": "Max Miller",
  "homepage": "https://github.com/max-miller1204/studens#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/max-miller1204/studens.git"
  },
  "bugs": {
    "url": "https://github.com/max-miller1204/studens/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "teaching",
    "learning",
    "classroom"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://raw.githubusercontent.com/max-miller1204/studens/main/screenshots/answer.png"
  },
  "scripts": {
    "version:bump": "node scripts/versions.ts bump",
    "version:check": "node scripts/versions.ts check",
    "verify": "node scripts/verify.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:claude": "node scripts/e2e.ts claude",
    "e2e:codex": "node scripts/e2e.ts codex",
    "e2e:browser": "node scripts/e2e-browser.ts",
    "e2e:pi": "node scripts/e2e-pi.ts",
    "e2e:quality": "node scripts/e2e-quality.ts",
    "e2e:feedback": "node scripts/e2e-feedback.ts",
    "e2e:authoring": "node scripts/e2e-authoring.ts",
    "check": "tsc --noEmit",
    "audit": "node scripts/check-runtime-dependencies.ts && npm audit --omit=dev --audit-level=moderate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "service": "node scripts/classroom-service.ts",
    "e2e:phone": "node scripts/e2e-phone.ts",
    "test:mutate": "stryker run"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.0.1",
    "marked": "^15.0.12",
    "parse5": "8.0.1"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "^24.5.2",
    "prettier": "^3.8.4",
    "typescript": "^5.9.3",
    "vite": "~7.3.7",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent": {
      "@earendil-works/chord": "1.0.1",
      "@earendil-works/pi-agent-core": "1.0.1",
      "@earendil-works/pi-ai": "1.0.1",
      "@earendil-works/pi-codemode": "1.0.1",
      "@earendil-works/pi-mcp": "1.0.1",
      "@earendil-works/pi-tui": "1.0.1",
      "@earendil-works/pi-telemetry": "1.0.1"
    },
    "@stryker-mutator/core": {
      "typed-rest-client": {
        "qs": "6.16.0"
      }
    }
  }
}
